<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>cz.bliksoft.java</groupId>
	<artifactId>bsnative-launcher</artifactId>
	<version>${revision}</version>
	<packaging>pom</packaging>

	<name>BSNative launcher</name>
	<description>Small prebuilt native launcher that runs a Java app under its own executable name, finding a JVM by itself. Copy it, rename it, and add an ini file.</description>
	<url>https://github.com/jelinj8/Java-BSNative-launcher</url>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>jelinj8</id>
			<name>Jakub Jelínek</name>
			<email>jakub.jelinek@gmail.com</email>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:https://github.com/jelinj8/Java-BSNative-launcher.git</connection>
		<developerConnection>scm:git:https://github.com/jelinj8/Java-BSNative-launcher.git</developerConnection>
		<url>https://github.com/jelinj8/Java-BSNative-launcher</url>
	</scm>

	<properties>
		<revision>0.2.0</revision>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- the binaries GitHub Actions built, placed here by scripts/publish-central.ps1 -->
		<binaries.dir>${project.basedir}/dist</binaries.dir>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<version>1.7.3</version>
				<configuration>
					<updatePomFile>true</updatePomFile>
					<flattenMode>ossrh</flattenMode>
				</configuration>
				<executions>
					<execution>
						<id>flatten</id>
						<phase>initialize</phase>
						<goals>
							<goal>flatten</goal>
						</goals>
					</execution>
					<execution>
						<id>flatten.clean</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<id>attach-binaries</id>
						<phase>package</phase>
						<goals>
							<goal>attach-artifact</goal>
						</goals>
						<configuration>
							<artifacts>
								<artifact>
									<file>${binaries.dir}/bsnative-launcher-win-x64.exe</file>
									<type>exe</type>
									<classifier>win-x64</classifier>
								</artifact>
								<artifact>
									<file>${binaries.dir}/bsnative-launcher-win-arm64.exe</file>
									<type>exe</type>
									<classifier>win-arm64</classifier>
								</artifact>
								<artifact>
									<file>${binaries.dir}/bsnative-launcher-linux-x64</file>
									<type>bin</type>
									<classifier>linux-x64</classifier>
								</artifact>
								<artifact>
									<file>${binaries.dir}/bsnative-launcher-linux-aarch64</file>
									<type>bin</type>
									<classifier>linux-aarch64</classifier>
								</artifact>
							</artifacts>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.8</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.10.0</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<autoPublish>false</autoPublish>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
